-horizontal_card    tm-wrapper-small\" >\n\n\t\t<div class=\"tm-horizontal_card\">\n\n\t\t\t<div class=\"uk-container\">\n\t\t\t\n\t\t\t\t\n\t\t\t\t\t<div class=\"tm-intro-text uk-margin-remove-last-child\" >\n\t\t\t\t\t\t<div class=\"uk-text-bold tm-text-24\">CULTURA RUSTICAE</div>\r\n<div class=\"tm-text-18\">Cerca de nuestros clientes y sus valores</div>\t\t\t\t\t</div>\n\n\t\t\t\t\n\t\t\t\n\t\t\t\n<div class=\"tm-horizontal_card-images\">\n\n\t\n\t\t<div class=\"uk-card uk-margin-medium-top uk-grid-collapse \" uk-grid>\n\t\t\t<div class=\"uk-card-media-left uk-cover-container uk-width-1-2@m\">\n\t\t\t\t\t\t\t\t\t<!-- Single image -->\n\n\t\t\t\t\t<div class=\"uk-cover-container uk-light uk-transition-toggle\" >\n\t\t\t\t\t\t<img alt=\"CULTURA RUSTICAE\" data-src=\"https://rusticae.es/images/webkit/image/1538-image-screen.jpg?1768302874\" data-srcset=\"https://rusticae.es/images/webkit/image/1538-image-tiny.jpg?1768302874 70w, https://rusticae.es/images/webkit/image/1538-image-small.jpg?1768302874 240w, https://rusticae.es/images/webkit/image/1538-image-med.jpg?1768302874 570w, https://rusticae.es/images/webkit/image/1538-image-screen.jpg?1768302874 870w\" data-width=\"\" data-height=\"\" uk-cover uk-img>\n\t\t\t\t\t\t<canvas width=\"4000\" height=\"3000\"></canvas>\n\n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\n\t\t\t\t\n\t\t\t</div>\n\t\t\t<div class=\"uk-width-expand@m uk-flex uk-flex-middle\">\n\t\t\t\t<div class=\"uk-card-body\">\n\t\t\t\t\t<div class=\"uk-margin tm-text-500 tm-text-40 tm-text-h120\">UN CLUB FORMADO<br>POR GENTE COMO TÚ.</div>\r\n<p class=\"uk-margin tm-text-18\">Creado por gente como nosotros... Que hace muchos años nos dimos cuenta de que había lugares únicos y escondidos que había que dar a conocer.</p>\r\n<p><a class=\"uk-button uk-button-text tm-text-18 tm-button-text-link\" href=\"/es/somos-rusticae\">Conoce nuestra historia <i class=\"fa fa-angle-right\"></i></a></p>\t\t\t\t</div>\n\t\t\t</div>\n\t\t</div>\n\n\t\n</div